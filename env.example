# Copy to .env and fill in the keys you have. All are optional for the
# deterministic demo (`python -m threat_detector.cli demo`), which uses fixtures.

# NOTE: the DEFAULT llm.backend is `ollama` — local, free, offline, and it needs
# nothing in this file. Set up with:
#   brew install ollama && ollama serve
#   ollama pull qwen3:8b && ollama pull gemma3:4b
# Verify with: python -m threat_detector.cli llm-check --deep

# --- LLM (only for llm.backend: anthropic) ----------------------------------
# CAREFUL: a key exported in your SHELL overrides this file. If .env looks
# right but calls still 401, check `env | grep ANTHROPIC`.
# Pay-per-token Anthropic API. NO quotes, no spaces: ANTHROPIC_API_KEY=sk-ant-...
# Not needed for the other backends: ollama / huggingface run locally for free,
# and claude_cli uses your ordinary Claude subscription via the `claude` CLI.
# Verify with: python -m threat_detector.cli llm-check --deep
ANTHROPIC_API_KEY=

# --- Embeddings (only for real RAG mode: retrieval.embeddings: voyage) -------
# Claude has no embeddings endpoint; Voyage AI is Anthropic's embedding partner.
# If left blank, the local offline concept embedder is used (default).
VOYAGE_API_KEY=

# --- Exa (Open-Source Monitoring agent, real news source) -------------------
# https://exa.ai -> dashboard -> API keys. Category=news search for current
# events. If left blank, news falls back to synthetic fixtures.
EXA_API_KEY=

# --- Reddit (Open-Source Monitoring agent, real social source) --------------
# Create a free "script" app at https://www.reddit.com/prefs/apps
# If left blank, the social tool falls back to synthetic fixtures.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=threat-detector-capstone/0.1 by u/your_username

# --- OpenStreetMap (Geospatial agent) ---------------------------------------
# No key required. Nominatim asks for a contact string in the User-Agent so they
# can reach you if a script misbehaves. Just put an email you control.
OSM_CONTACT_EMAIL=you@example.com
